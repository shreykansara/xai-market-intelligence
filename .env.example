# ==============================================================================
# Omniscope AI - Deployment Environment Variables
# ==============================================================================

# Server Port (PaaS hosts like Render/Railway automatically inject PORT)
PORT=5000

# PostgreSQL Supabase Database URL (pgvector enabled)
SUPABASE_DB_URL=postgresql://postgres.fqmrguogcptkpsbhdmgo:efO5FSkBGg8iQlws@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

# Groq API Key (Free high-speed LLM inference for Omniscope Chatbot)
# Obtain a free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Cloud Embeddings API Provider (No local heavy PyTorch/Transformer packages needed)
# Option 1 (Default/Free): Hugging Face Inference API
HF_TOKEN=your_huggingface_token_here

# Option 2 (Alternative): OpenAI Embeddings API
OPENAI_API_KEY=your_openai_api_key_here

# Platform Admin Console Secret (Used for cryptographically signing admin tokens)
ADMIN_AUTH_SECRET=omniscope_strategic_admin_secret_key_2026_shrey
