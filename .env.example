# Copy this file to `.env` and fill in your key:
#     cp .env.example .env
#
# `.env` is gitignored and must never be committed. This template is committed
# so the required variables are discoverable without exposing any secret.
#
# Loaded automatically by src/marketintel/config.py, which every entry point
# imports - so server.py, ingestion_service.py and the scripts/ all pick it up
# with no extra wiring. A real environment variable always overrides the value
# here (shell export, CI secret, systemd Environment=), so this file is a
# convenient default, not an override.

# --- Groq API (fact decomposition + LPU classification) -------------------
# Required only when config.LLM_PROVIDER = "groq". Get a key from
# https://console.groq.com/keys
GROQ_API_KEY=

# --- Supabase (Postgres + pgvector) ----------------------------------------
# Connection string for the growing data (facts, announcements, embeddings,
# ingestion runs). Supabase dashboard -> Project Settings -> Database ->
# Connection string -> URI. Use the POOLER (port 6543) for serverless/short-lived
# connections like the GitHub Actions job; the direct port (5432) is fine for
# long-lived processes.
DATABASE_URL=

# --- Optional overrides ---------------------------------------------------
# Uncomment to point at a non-default local Ollama (used when
# config.LLM_PROVIDER = "ollama", which is the recommended setting for BULK
# LPU ingestion - see README's "Hosting requirements" for the measured
# 9.4-days-vs-343-days comparison).
# OLLAMA_HOST=http://localhost:11434
